# ApnarDokan frontend environment
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_MODE:
#   "mock" -> RTK Query serves local mock data (no backend needed)
#   "real" -> RTK Query calls the Laravel API below
NEXT_PUBLIC_API_MODE=real

# Laravel API base (must include the /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
